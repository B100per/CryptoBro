rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One person may read the books and press Start/Stop: you, signed in with
    // Google. Put your own address in OWNER_EMAIL before deploying. Nobody
    // else, signed in or not, can read a single document.
    function owner() {
      return request.auth != null && request.auth.token.email == "OWNER_EMAIL";
    }
    match /control/{doc}  { allow read, write: if owner(); }
    match /books/{book}   { allow read: if owner(); allow write: if false; }
    match /books/{book}/{sub=**} { allow read: if owner(); allow write: if false; }
  }
}
