<plist version="1.0">
<dict>
  <key>Label</key><string>com.b100per.cryptobro.retention</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>/Users/100per/GitHub/CryptoBro/retention.py</string>
    <string>--days</string>
    <string>45</string>
