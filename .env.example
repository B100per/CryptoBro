# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Futures TESTNET keys: https://testnet.binancefuture.com
#   (NOT testnet.binance.vision, that one is spot-only and its keys are rejected here.)
#
# Keys must come from binance.com or its futures testnet. A binance.th (Binance TH)
# key will NOT work: it is a separate exchange, and it has no futures market at all,
# so none of the funding / open interest / long-short data this bot trades on exists there.
BINANCE_KEY=
BINANCE_SECRET=

# Hard ceiling on gross position notional, in USDT. No order is sent without it.
# 1000 THB is roughly 29 USDT.
MAX_NOTIONAL_USDT=29

# Hard ceiling on Binance TH spot holdings, in THB. Used by binance_th.py.
MAX_NOTIONAL_THB=1000

# Stop buying for the rest of the day after this drop in account equity.
DAILY_DRAWDOWN_LIMIT=0.05

# Uncomment ONLY when you deliberately want to trade the real account with real money.
# BINANCE_LIVE=1
