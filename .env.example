# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Futures TESTNET keys: https://testnet.binancefuture.com
#   (NOT testnet.binance.vision, that one is spot-only and its keys are rejected here.)
BINANCE_KEY=
BINANCE_SECRET=

# Hard ceiling on gross position notional, in USDT. No order is sent without it.
# 1000 THB is roughly 29 USDT.
MAX_NOTIONAL_USDT=29

# Uncomment ONLY when you deliberately want to trade the real account with real money.
# BINANCE_LIVE=1
